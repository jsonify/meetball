<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.meetball.MeetballPhone.refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Meetball</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Meetball</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.meetball.MeetballPhone</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>meetball</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>MeetballBuildDate</key>
	<string>$(MEETBALL_BUILD_DATE)</string>
	<key>MeetballCommit</key>
	<string>$(MEETBALL_COMMIT)</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Meetball shows your calendars, reminds you before meetings, tells you when one moves or is cancelled, and adds the events you type into quick add.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Meetball works out the drive to your games, parties and appointments from where you are, so it can tell you when to leave.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Echo records a short voice note after a meeting, only while you're recording.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Echo adds your after-meeting notes to Reminders as follow-ups.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Echo turns your voice note into text on your iPhone, so it can become a follow-up reminder.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
