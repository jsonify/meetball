Config/Secrets.xcconfig
*.xcuserstate
xcuserdata/
DerivedData/
.DS_Store
build/
dist/

# Meetball.xcodeproj is generated by `xcodegen generate` from project.yml, so it isn't tracked.
# The one exception is Package.resolved, which pins the Swift package versions (SK1Kit) and is committed.
Meetball.xcodeproj/*
!Meetball.xcodeproj/project.xcworkspace/
Meetball.xcodeproj/project.xcworkspace/*
!Meetball.xcodeproj/project.xcworkspace/xcshareddata/
Meetball.xcodeproj/project.xcworkspace/xcshareddata/*
!Meetball.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
Meetball.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Meetball.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
